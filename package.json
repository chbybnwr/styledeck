{
  "name": "visinagecss",
  "version": "0.0.0",
  "description": "Visinage CSS",
  "license": "UNLICENSED",
  "keywords": [
    "css",
    "inline",
    "style",
    "stylex"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "check": "run-s \"test -- --coverage --reporter=verbose\" lint \"format -- --check\" spellcheck",
    "prepack": "shx cp package.json package.json.backup && npm pkg delete scripts packageManager devDependencies",
    "postpack": "shx rm package.json && shx mv package.json.backup package.json",
    "build": "vite build",
    "compile": "tsc --project tsconfig.build.json",
    "extract": "shx rm -rf ./lib/ && npm run compile && api-extractor run --local",
    "test": "vitest run",
    "lint": "eslint ./ --cache",
    "format": "prettier ./",
    "spellcheck": "cspell ./",
    "local-pack": "run-s build extract && npm pack"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@stylexjs/stylex": "~0.18.2",
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@microsoft/api-extractor": "^7.58.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@txee/tsconfig": "file:../tsconfig",
    "@types/babel__traverse": "^7.28.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.2",
    "@typescript-eslint/parser": "^8.58.1",
    "@typescript/native-preview": "7.0.0-dev.20260408.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/eslint-plugin": "^1.6.14",
    "cspell": "^10.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "shx": "~0.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  }
}
