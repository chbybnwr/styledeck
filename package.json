{
  "name": "styledeck",
  "version": "0.8.22",
  "description": "Type-safe and zero-runtime UI styling, right in the markup.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chbybnwr/styledeck.git"
  },
  "homepage": "https://github.com/chbybnwr/styledeck",
  "bugs": {
    "url": "https://github.com/chbybnwr/styledeck/issues"
  },
  "funding": "https://github.com/sponsors/chbybnwr",
  "keywords": [
    "css",
    "inline",
    "jsx",
    "style",
    "styledeck",
    "stylex",
    "styling",
    "ui"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "npm run build && npm pkg delete scripts packageManager devDependencies",
    "check": "npm run test -- --coverage && npm run lint && npm run format -- --check && npm run spellcheck",
    "build": "tsdown",
    "compile": "tsc --project tsconfig.build.json",
    "extract": "npm run compile && api-extractor run",
    "extract:local": "npm run extract -- --local",
    "test": "vitest run",
    "lint": "npm run oxlint && npm run eslint",
    "eslint": "eslint ./",
    "oxlint": "oxlint ./",
    "format": "prettier ./",
    "spellcheck": "cspell ./"
  },
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "~0.18.3"
  },
  "devDependencies": {
    "@chbybnwr/tsconfig": "github:chbybnwr/tsconfig#v0.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@microsoft/api-extractor": "^7.58.12",
    "@stylexjs/stylex": "~0.19.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "cspell": "^10.0.1",
    "dotenv": "^17.4.2",
    "es-toolkit": "^1.50.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.7.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "tsdown": "~0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
