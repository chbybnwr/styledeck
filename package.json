{
  "name": "styledeck",
  "version": "0.8.22",
  "description": "Type-safe and zero-runtime UI styling, right in the markup.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chbybnwr/styledeck.git"
  },
  "homepage": "https://github.com/chbybnwr/styledeck",
  "bugs": {
    "url": "https://github.com/chbybnwr/styledeck/issues"
  },
  "funding": "https://github.com/sponsors/chbybnwr",
  "keywords": [
    "css",
    "inline",
    "jsx",
    "style",
    "styledeck",
    "stylex",
    "styling",
    "ui"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "pn build && pn pkg delete scripts packageManager devDependencies",
    "check": "run-s 'test --coverage' typecheck lint 'format --check' spellcheck",
    "build": "tsdown",
    "extract": "tsc --project tsconfig.build.json && api-extractor run",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "lint": "run-s oxlint eslint",
    "eslint": "eslint ./",
    "oxlint": "oxlint ./",
    "format": "prettier ./",
    "spellcheck": "cspell ./"
  },
  "packageManager": "pnpm@11.10.0",
  "peerDependencies": {
    "@stylexjs/stylex": "~0.19.0"
  },
  "devDependencies": {
    "@chbybnwr/tsconfig": "github:chbybnwr/tsconfig#v0.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@faker-js/faker": "^10.6.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "cspell": "^10.1.1",
    "csstype": "^3.2.3",
    "dotenv": "^17.4.2",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.11.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "tsdown": "~0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
