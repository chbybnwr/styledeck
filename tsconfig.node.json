{
  "extends": [
    "@txe/tsconfig/tsconfig.base.json",
    "@txe/tsconfig/tsconfig.node24.json"
  ],

  "include": ["./*"],

  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "preserve",
    "moduleResolution": "bundler",

    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true
  }
}
