{
  "extends": [
    "@chbybnwr/tsconfig/tsconfig.base.json",
    "@chbybnwr/tsconfig/tsconfig.library.json",
    "@chbybnwr/tsconfig/tsconfig.vite.json"
  ],
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec*.*", "src/test/**/*"],

  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",

    "rootDir": "./src/",
    "outDir": "./dist/",
    "noUnusedLocals": false,

    "emitDeclarationOnly": true,
    "declarationDir": "./lib/"
  }
}
